# ---------------------------------------------------------------------------
# ToolGlobe — Environment Variables
# Copy this file to .env.local for local development.
# ---------------------------------------------------------------------------

# Public site URL — used for absolute canonical URLs, sitemaps, JSON-LD, and
# OpenGraph tags. Must NOT have a trailing slash.
NEXT_PUBLIC_SITE_URL=https://toolglobe.app

# Search Console / Bing Webmaster HTML verification meta tag content.
SITE_VERIFICATION_GOOGLE=
SITE_VERIFICATION_BING=

# --- Rate limiting (lib/rate-limit.ts, enforced in middleware.ts) ---
# Max requests allowed per client identifier within the sliding window below.
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_WINDOW_MS=60000

# --- Adsterra Monetization (Phase 7) ---
# Social Bar: paste the invoke-script URL exactly as issued by Adsterra.
# Leave blank to disable — the component renders nothing when unset.
NEXT_PUBLIC_ADSTERRA_SOCIAL_BAR_SRC=

# Native Banner: paste the invoke-script URL for this placement.
NEXT_PUBLIC_ADSTERRA_NATIVE_BANNER_SRC=

# Native Banner: paste the matching container element ID from the same
# Adsterra snippet (e.g. "container-1a2b3c4d5e6f7890abcd1234ef567890").
NEXT_PUBLIC_ADSTERRA_NATIVE_BANNER_CONTAINER_ID=
