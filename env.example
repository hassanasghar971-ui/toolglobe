# ToolGlobe — Environment Variables Template
# Copy to .env.local for development, and configure identically
# in Vercel Project Settings for Production/Preview environments.

# --- Core Site Identity ---
NEXT_PUBLIC_SITE_URL=https://toolglobe.app

# --- Search Engine Verification (Phase 4 consumes these) ---
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# --- Rate Limiting (middleware.ts / lib/rate-limit.ts) ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120

# --- Monetization (populated in Phase 7, left blank intentionally) ---
NEXT_PUBLIC_ADSTERRA_SOCIAL_BAR_KEY=
NEXT_PUBLIC_ADSTERRA_NATIVE_BANNER_KEY=
