"use client";

import React, { Suspense, lazy, useCallback, useState } from "react";
import { useInteraction } from "@/context/InteractionContext";

const MergePdfProcessor = lazy(() => import("./processors/MergePdfProcessor"));
const SplitPdfProcessor = lazy(() => import("./processors/SplitPdfProcessor"));
const CompressPdfProcessor = lazy(() => import("./processors/CompressPdfProcessor"));
const ImagesToPdfProcessor = lazy(() => import("./processors/ImagesToPdfProcessor"));
const PdfToImagesProcessor = lazy(() => import("./processors/PdfToImagesProcessor"));
const PdfToExcelProcessor = lazy(() => import("./processors/PdfToExcelProcessor"));
const OcrPdfProcessor = lazy(() => import("./processors/OcrPdfProcessor"));

const PROCESSOR_REGISTRY: Record<string, React.LazyExoticComponent<React.ComponentType<object>>> = {
  "merge-pdf": MergePdfProcessor,
  "split-pdf": SplitPdfProcessor,
  "compress-pdf": CompressPdfProcessor,
  "jpg-to-pdf": ImagesToPdfProcessor,
  "images-to-pdf": ImagesToPdfProcessor,
  "pdf-to-jpg": PdfToImagesProcessor,
  "pdf-to-images": PdfToImagesProcessor,
  "pdf-to-excel": PdfToExcelProcessor,
  "ocr-pdf": OcrPdfProcessor,
};

interface ToolWorkspaceProps {
  slug: string;
  toolName: string;
}

export default function ToolWorkspace({ slug, toolName }: ToolWorkspaceProps) {
  const { registerInteraction } = useInteraction();
  const [hasStarted, setHasStarted] = useState(false);

  const ActiveProcessor = PROCESSOR_REGISTRY[slug];

  const handleStart = useCallback(() => {
    if (!hasStarted) {
      setHasStarted(true);
      registerInteraction();
    }
  }, [hasStarted, registerInteraction]);

  if (!ActiveProcessor) {
    return (
      <div className="w-full rounded-2xl border border-slate-200 bg-white p-10 text-center shadow-sm">
        <h3 className="text-xl font-bold text-slate-800">{toolName} engine is being optimized</h3>
        <p className="mt-2 text-slate-500">
          This tool module is currently being finalized for the next release of PDF Lovers Pro.
          Please check back shortly, or contact{" "}
          <a href="mailto:hassanasghar7868686@gmail.com" className="text-red-600 underline">
            hassanasghar7868686@gmail.com
          </a>{" "}
          for priority access.
        </p>
      </div>
    );
  }

  return (
    <div onClickCapture={handleStart} onDropCapture={handleStart} className="w-full">
      <Suspense
        fallback={
          <div className="flex h-64 w-full items-center justify-center rounded-2xl border border-slate-200 bg-white">
            <span className="h-8 w-8 animate-spin rounded-full border-4 border-red-500 border-t-transparent" />
          </div>
        }
      >
        <ActiveProcessor />
      </Suspense>
    </div>
  );
}
